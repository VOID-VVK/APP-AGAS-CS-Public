{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agas.local/schemas/ai-provider-v1.json",
  "title": "AGAS AI Provider Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "adapterKind", "defaultBaseUrl", "models", "capabilities", "credential"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "adapterKind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "defaultBaseUrl": { "type": "string", "format": "uri" },
    "models": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["recommended"],
        "properties": { "recommended": { "const": true } }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelName", "label", "recommended"],
        "properties": {
          "modelName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "recommended": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["textToImage", "referenceEdit", "regionEdit", "nativeAlphaMask", "guidedRegionEdit"] }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "settingsKey"],
      "properties": {
        "kind": { "const": "profileSettings" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "settingsKey": { "const": "apiKey" }
      }
    },
    "baseUrlHint": { "type": "string", "maxLength": 1000 },
    "baseUrlPlaceholder": { "type": "string", "format": "uri" },
    "order": { "type": "integer" }
  }
}
